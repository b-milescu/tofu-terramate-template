{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  semanticCommits: "enabled", // chore(deps): ..., accepted by the commit-msg hook (conventional-pre-commit)
  "pre-commit": { enabled: true }, // off by default
  minimumReleaseAge: "3 days", // wait 3 days after a release before opening a PR
  prConcurrentLimit: 5,
  prHourlyLimit: 0, // config:recommended allows 2 PRs an hour: the first run would stop after two
  automerge: true, // not production code: every update that Renovate can propose merges once smoke-test (check-all + e2e, all four folders) is green; a red one stays open
  automergeStrategy: "squash", // one conventional "chore(deps): update ..." commit per bump
  customManagers: [
    {
      // emulator images in e2e.sh: IMAGE=${E2E_IMAGE:-floci/floci-gcp:0.11.0}
      customType: "regex",
      managerFilePatterns: ["/(^|/)e2e\\.sh$/"],
      matchStrings: ["\\$\\{E2E_[A-Z_]*:-(?<depName>[^:}@\\s]+):(?<currentValue>[^@}\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\\}"],
      datasourceTemplate: "docker",
    },
    {
      // terramate floor: required_version = "~> 0.17.3", bumped in the same PR as the terramate line of .tool-versions
      customType: "regex",
      managerFilePatterns: ["/(^|/)terramate\\.tm\\.hcl$/"],
      matchStrings: ["required_version\\s*=\\s*\"~>\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "terramate",
      packageNameTemplate: "terramate-io/terramate",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
  ],
  packageRules: [
    {
      // providers, their constraints and every .terraform.lock.hcl move together with make relock
      matchDatasources: ["terraform-provider"],
      enabled: false,
    },
    {
      // the gcp README's emulator-gap sentences and the floci-az / vcsim / GitLab CE notes were measured on the pinned images; a bump merges once e2e is green, the prose is not re-measured
      matchManagers: ["custom.regex"],
      matchDepNames: ["floci/floci-gcp", "floci/floci-az", "vmware/vcsim", "gitlab/gitlab-ce"],
      prBodyNotes: ["Merges when `smoke-test` is green. Prose that quotes the old version (`git grep -n <old version>`) is not updated by Renovate."],
    },
  ],
}
